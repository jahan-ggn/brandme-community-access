generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model CreatorMapping {
  id                  Int              @id @default(autoincrement())
  shop                String
  shopifyCollectionId String
  collectionName      String
  discourseUrl        String
  connectionSecret    String
  enabled             Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  products            ProductMapping[]

  @@unique([shop, shopifyCollectionId])
}

model ProductMapping {
  id               Int            @id @default(autoincrement())
  shop             String
  shopifyProductId String
  creatorMapping   CreatorMapping @relation(fields: [creatorMappingId], references: [id], onDelete: Cascade)
  creatorMappingId Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([creatorMappingId, shopifyProductId])
  @@index([shop, shopifyProductId])
  @@index([creatorMappingId])
}

model ProcessedWebhook {
  id          Int       @id @default(autoincrement())
  webhookId   String    @unique
  shop        String
  resourceId     String
  eventType   String
  status      String    @default("processed")
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([shop])
  @@index([resourceId])
}

model DeliveryLog {
  id                 Int      @id @default(autoincrement())
  shop               String
  orderId            String
  customerEmail      String
  productId          String
  discourseCommunity String
  eventType          String   @default("purchase")
  status             String   @default("pending")
  errorMessage       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([orderId, productId, discourseCommunity, eventType])
  @@index([shop])
  @@index([orderId])
  @@index([customerEmail])
}

model RetryQueue {
  id               Int       @id @default(autoincrement())
  shop             String
  orderId          String
  customerEmail    String
  productId        String
  discourseUrl    String
  connectionSecret String
  eventType        String
  attemptCount     Int       @default(0)
  maxAttempts      Int       @default(5)
  nextRetryAt      DateTime  @default(now())
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([nextRetryAt])
  @@index([shop])
}
